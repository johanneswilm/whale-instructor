# Whale Instructor — keep archived, generated and downloaded material out
# of version control. See PUBLISHING.md.

# --- private research/archive area (vendor-derived material, RE notes,
#     old bring-up logs; see its own AGENTS.md) ---
attic/

# --- private material, if present  ---
/dist/
.envrc
/.direnv/
*.egg-info/

# --- binaries: built archives, linked images, vendor executables ---
*.a
*.dll
*.exe
*.deb
*.bin

# --- generated build/test artifacts ---
artifacts/
__pycache__/
*.pyc

# --- obsolete local program store (programs are files you keep anywhere) ---
programs/

# --- publish staging tree (generated by make_publish.py) ---
publish/

# --- setuptools build dir ---
build/
