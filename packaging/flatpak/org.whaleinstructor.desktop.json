{
  "id": "org.whaleinstructor.desktop",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "whale-ide",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=all",
    "--share=network",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "whale-instructor",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --verbose --no-index --no-build-isolation --prefix=${FLATPAK_DEST} .",
        "install -Dm644 packaging/flatpak/org.whaleinstructor.desktop.desktop ${FLATPAK_DEST}/share/applications/org.whaleinstructor.desktop.desktop",
        "install -Dm644 packaging/flatpak/org.whaleinstructor.desktop.metainfo.xml ${FLATPAK_DEST}/share/metainfo/org.whaleinstructor.desktop.metainfo.xml",
        "for s in 32 128 256 512; do install -Dm644 whale_instructor/static/favicon.png ${FLATPAK_DEST}/share/icons/hicolor/${s}x${s}/apps/org.whaleinstructor.desktop.png; done"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
