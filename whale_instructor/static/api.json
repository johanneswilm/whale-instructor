  {
   "category": "Display",
   "description": "Clear the controller screen.",
   "name": "clear_screen",
   "signature": "clear_screen()"
  },
  {
   "category": "Display",
   "description": "Draw an 8x8 pattern: eight row bitmasks 0..255, top row first. 0b11111111 = 255 = full row.",
   "name": "display_custom",
   "signature": "display_custom(port, r0, r1, ..., r7)"
  },
  {
   "category": "Display",
   "description": "Show a number on a digital tube display.",
   "name": "display_digital_tube",
   "signature": "display_digital_tube(port, number)"
  },
  {
   "category": "Display",
   "description": "Show two numbers (a score) on a tube.",
   "name": "display_digital_tube_score",
   "signature": "display_digital_tube_score(p, left, right)"
  },
  {
   "category": "Display",
   "description": "Show a LED_emoji_* face across two matrix eyes.",
   "name": "display_emotion",
   "signature": "display_emotion(left_port, right_port, emoji)"
  },
  {
   "category": "Display",
   "description": "Show a number on the controller screen.",
